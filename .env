SERVER_PORT=8091

# A separate database from the wallet service.
MONGODB_URI=mongodb://localhost:27017/premisave_developer

# Signs developer portal tokens. At least 32 characters.
DEVELOPER_JWT_SECRET=change-me-to-a-long-random-value-0123456789

# Keys the hash of every API secret. At least 16 characters. Changing it invalidates every API key.
API_KEY_PEPPER=change-me-too-0123456789

# Where the wallet service runs, and the internal key it expects (the wallet's INTERNAL_API_KEY).
WALLET_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=change-me-same-as-the-wallet

# Only when the wallet has commercial.signing.enabled=true. Must be one of its commercial.signing.secrets.
WALLET_SIGNING_SECRET=

# Guards /internal/admin. Empty means those endpoints refuse every call.
DEVELOPER_INTERNAL_API_KEY=

# Browser origins allowed to call /api/v1, comma separated. Never opened on /v1.
DEVELOPER_PORTAL_ORIGINS=http://localhost:3000

# Where the portal runs. Confirmation and reset links in emails point here.
DEVELOPER_PORTAL_URL=http://localhost:3000

# Email. Leave SPRING_MAIL_HOST unset to send nothing.
DEVELOPER_MAIL_FROM=no-reply@example.com
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Development only: log the links instead of sending when no mail server is set.
DEVELOPER_MAIL_LOG_LINKS=false

# Sign in with Google, Facebook and GitHub. A provider is on when it has an id and a secret.
# Exact portal callback addresses, comma separated. Empty turns social sign in off.
DEVELOPER_OAUTH_REDIRECT_URIS=http://localhost:3000/auth/callback/google,http://localhost:3000/auth/callback/facebook,http://localhost:3000/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
