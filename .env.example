# Premisave developer service. Copy this file to .env in the folder you start the service from, and fill it in.
# The service reads .env at startup (spring.config.import). Real environment variables win over it.
# Plain KEY=value lines, no quotes. Do not commit .env: add it to .gitignore. Make a secret with: openssl rand -base64 32
# This file holds no real value on purpose, so a secret scanner has nothing to flag. Fill the empty secrets in your own .env.

SERVER_PORT=8091

# A separate database from the wallet service.
MONGODB_URI=mongodb://localhost:27017/premisave_developer

# Signs developer portal tokens. At least 32 characters. Generate one with: openssl rand -base64 32
DEVELOPER_JWT_SECRET=

# Keys the hash of every API secret. At least 16 characters. Changing it invalidates every API key.
# Generate one with: openssl rand -base64 32
API_KEY_PEPPER=

# Where the wallet service runs, and the internal key it expects (the wallet's INTERNAL_API_KEY).
WALLET_SERVICE_URL=http://localhost:8084
INTERNAL_API_KEY=

# Only when the wallet has commercial.signing.enabled=true. Must be one of its commercial.signing.secrets.
WALLET_SIGNING_SECRET=

# Guards /internal/admin. Empty means those endpoints refuse every call. Generate one with: openssl rand -base64 32
DEVELOPER_INTERNAL_API_KEY=

# Browser origins allowed to call /api/v1, comma separated. Never opened on /v1.
DEVELOPER_PORTAL_ORIGINS=http://localhost:3000

# Where the portal runs. Confirmation and reset links in emails point here.
DEVELOPER_PORTAL_URL=http://localhost:3000

# Email, through Gmail. MAIL_HOST is the mail server (smtp.gmail.com), not an email address.
# MAIL_USERNAME is the full Gmail address. MAIL_PASSWORD is a 16 character Google App Password, not the account
# password: turn on 2 step verification, then create one at https://myaccount.google.com/apppasswords
# Paste the App Password as Google shows it or without spaces, with or without quotes: the service removes them.
# Gmail sends as the signed in account whatever From says, so keep DEVELOPER_MAIL_FROM equal to MAIL_USERNAME.
# Use these MAIL_* names. The old SPRING_MAIL_* names are not read.
# MAIL_HOST defaults to smtp.gmail.com and MAIL_PORT to 587, so for Gmail only the username and password are needed.
# Leave MAIL_USERNAME empty (or comment it out) to send nothing.
DEVELOPER_MAIL_FROM=you@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
# Email the owner on every successful sign in, with the time, device and network address.
DEVELOPER_MAIL_NOTIFY_SIGN_IN=true
# Development only: log the links instead of sending when no mail server is set.
DEVELOPER_MAIL_LOG_LINKS=false
# Check the mail settings each time the service starts and write the result to the log: is mail on, does the mail
# server accept the login, and, when an address is given, send one test email to it. Look for "Mail check:" in the log.
# It never stops the service from starting. Clear the address (or set the check to false) once mail works,
# or every start sends a test email.
DEVELOPER_MAIL_STARTUP_CHECK=false
DEVELOPER_MAIL_STARTUP_CHECK_SEND_TO=

# Profile pictures are stored in Cloudinary. Copy the three values from the Cloudinary dashboard.
# With any of them empty, profile pictures are off and everything else works.
# CLOUDINARY_FOLDER is where the pictures go (default premisave/developers). CLOUDINARY_MAX_BYTES is the largest
# picture accepted (default 5242880, which is 5 MB, never more than 10 MB).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premisave/developers
CLOUDINARY_MAX_BYTES=5242880

# Sign in with Google, Facebook and GitHub. The browser gets the provider token and posts it to
# /api/v1/auth/social/google, /facebook or /github, so there is no redirect address to set here.
# Google needs only the client ID. Facebook and GitHub need the ID and the secret. A provider with
# missing values is off. The portal origin must be in DEVELOPER_PORTAL_ORIGINS.
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# How many businesses one developer account may apply for. Each has its own application and apps.
DEVELOPER_MAX_BUSINESSES=10
